# Google Gemini API Key (required)
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_api_key_here

# Gemini Model Configuration
# Options:
#   - gemini-2.0-flash-exp (experimental, faster, recommended for testing)
#   - gemini-2.0-flash (stable, fast, cost-effective)
#   - gemini-1.5-flash (older stable version)
#   - gemini-1.5-pro (high quality, larger context)
GEMINI_MODEL=gemini-2.0-flash-exp

# Upload Configuration
UPLOAD_DIR=/tmp/videos
MAX_FILE_SIZE=2147483648  # 2GB in bytes

# Server Configuration
HOST=0.0.0.0
PORT=8000
